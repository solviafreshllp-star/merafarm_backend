# --- Database ---
DATABASE_URL="postgresql://postgres:India@2994@localhost:5432/merafarmDB?schema=public"

# --- Redis (BullMQ jobs + Socket.IO adapter) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- OTP provider ---
# In development, OtpService just logs the OTP to the console (see
# src/auth/otp.service.ts). Swap in MSG91 / Twilio / Firebase Auth for
# production and this env var selects the driver.
OTP_PROVIDER="console"
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Payments ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- App ---
PORT=4000
CORS_ORIGIN="http://localhost:3000"
