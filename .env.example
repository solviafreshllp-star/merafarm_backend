# --- Database ---
# Matches ../docker-compose.yml's postgres service (POSTGRES_USER/PASSWORD/DB
# all "merafarm"). If you're running your own local Postgres instead of the
# compose file, substitute your own user/password/db name here — just keep
# this file and docker-compose.yml in sync so a fresh checkout works either way.
DATABASE_URL="postgresql://merafarm:merafarm@localhost:5432/merafarm?schema=public"

# --- Redis (BullMQ jobs + Socket.IO adapter) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- OTP provider ---
# In development, OtpService just logs the OTP to the console (see
# src/auth/otp.service.ts). Swap in MSG91 / Twilio / Firebase Auth for
# production and this env var selects the driver.
OTP_PROVIDER="console"
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Payments ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- App ---
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# development | test | production — gates Swagger docs (main.ts) and which
# env vars src/config/env.validation.ts treats as required.
NODE_ENV="development"

# --- Order expiry job (src/jobs/order-expiry.service.ts) ---
# Minutes a PENDING_PAYMENT order/OrderGroup can sit before it's auto-cancelled.
ORDER_EXPIRY_MINUTES=15

# --- Media (Cloudflare Images — see ../MEDIA-STRATEGY.md) ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_TOKEN=""
